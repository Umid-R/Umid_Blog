---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

{posts.length === 0 ? (
  <p class="muted">No posts yet.</p>
) : (
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
        <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
      </li>
    ))}
  </ul>
)}

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .posts a { color: var(--fg); }
  .posts time { color: var(--muted); font-size: 0.9rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
