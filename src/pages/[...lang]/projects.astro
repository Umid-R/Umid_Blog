---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { ui, langPaths, type Lang } from '../../i18n/ui';
import { PROJECTS, STACK_ICON } from '../../data/profile';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---

<Base lang={lang} route="/projects" title={t.sec.projects} description={t.projectsSub}>
  <h1>{t.sec.projects}</h1>
  <p class="muted">{t.projectsSub}</p>
  <div style="margin-top: 1.5rem">
    {PROJECTS.map((p) => {
      const detail = p.slug ? `/projects/${p.slug}/` : null;
      return (
        <article class="card">
          <h3>{detail ? <a href={detail}>{p.name}</a> : <a href={p.link} target="_blank" rel="noopener">{p.name} ↗</a>}</h3>
          <p>{t.projects[p.key]}</p>
          <div class="stack">
            {p.stack.map((s) => <span class="chip"><Icon name={STACK_ICON[s] ?? 'database'} size={15} />{s}</span>)}
          </div>
          <div class="actions">
            {detail && <a href={detail} class="more">{t.more}</a>}
            <a href={p.link} target="_blank" rel="noopener" class="gh" aria-label="GitHub"><Icon name="github" mono size={16} /> GitHub</a>
          </div>
        </article>
      );
    })}
  </div>
</Base>

<style>
  .card { border: 1px solid var(--line); background: var(--card); border-radius: 10px; padding: 18px 20px 14px; margin-bottom: 14px; transition: border-color 0.15s; }
  .card:hover { border-color: var(--muted); }
  h3 { margin: 0 0 6px; font-size: 1.08rem; }
  h3 a { color: var(--fg); }
  p { margin: 0 0 12px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; border: 1px solid var(--line); background: var(--bg); border-radius: 999px; padding: 3px 10px 3px 8px; color: var(--fg); }
  .actions { display: flex; align-items: center; gap: 18px; font-size: 0.92rem; }
  .more { font-weight: 600; }
  .gh { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); }
  .gh:hover { color: var(--fg); text-decoration: none; }
</style>
