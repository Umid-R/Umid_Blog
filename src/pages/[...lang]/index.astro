---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { ui, localize, langPaths, type Lang } from '../../i18n/ui';
import { CONTACT, SKILLS } from '../../data/profile';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const groups = Object.entries(SKILLS) as [keyof typeof SKILLS, (typeof SKILLS)[keyof typeof SKILLS]][];
---

<Base lang={lang} route="/">
  <section class="hero">
    <div class="avatar">U</div>
    <div>
      <h1>{t.greeting}</h1>
      <p class="muted role">{t.role}</p>
    </div>
  </section>

  <section class="about">
    {t.about.map((p) => <p>{p}</p>)}
  </section>

  <div class="contacts">
    <a href={`mailto:${CONTACT.email}`} class="btn"><Icon name="mail" mono size={16} /> {t.email}</a>
    <a href={CONTACT.github} target="_blank" rel="noopener" class="btn"><Icon name="github" mono size={16} /> GitHub</a>
    <a href={CONTACT.linkedin} target="_blank" rel="noopener" class="btn"><Icon name="linkedin" mono size={16} /> LinkedIn</a>
    {CONTACT.telegram && <a href={CONTACT.telegram} target="_blank" rel="noopener" class="btn"><Icon name="telegram" mono size={16} /> Telegram</a>}
  </div>

  <h2 class="section-title">{t.sec.education}</h2>
  {t.education.map((e) => (
    <div class="entry">
      <div class="row"><strong>{e.title}</strong><span class="muted period">{e.period}</span></div>
      <div>{e.org}</div>
      <div class="muted small">{[e.place, e.note].filter(Boolean).join(' · ')}</div>
    </div>
  ))}

  <h2 class="section-title">{t.sec.experience}</h2>
  {t.experience.map((e) => (
    <div class="entry">
      <div class="row"><strong>{e.title}</strong><span class="muted period">{e.period}</span></div>
      <div class="muted">{e.org}</div>
      {e.note && <p class="small">{e.note}</p>}
    </div>
  ))}

  <h2 class="section-title">{t.sec.skills}</h2>
  {groups.map(([key, items]) => (
    <div class="skill-group">
      <div class="muted small group-name">{t.skillGroups[key]}</div>
      <div class="skills">
        {items.map((s) => <span class="skill"><Icon name={s.icon} size={18} />{s.label}</span>)}
      </div>
    </div>
  ))}

  <h2 class="section-title">{t.sec.languages}</h2>
  <div class="langs-grid">
    {t.languages.map((l) => (
      <div class="lang-item"><strong>{l.name}</strong><span class="muted small">{l.level}</span></div>
    ))}
  </div>

  <h2 class="section-title">{t.sec.posts}</h2>
  <PostList posts={posts} />
  <p class="more">
    <a href={localize(lang, '/blog')}>{t.allPosts}</a>
    <a href={localize(lang, '/projects')}>{t.allProjects}</a>
  </p>
</Base>

<style>
  .hero { display: flex; align-items: center; gap: 18px; margin-bottom: 1.2rem; }
  .avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 1.7rem; font-weight: 700; flex-shrink: 0; }
  .hero h1 { margin: 0; font-size: 1.9rem; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: -0.02em; }
  .hero h1::after { content: '_'; color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero h1::after { animation: none; } }
  .role { margin: 2px 0 0; }
  .about p { margin: 0 0 0.8rem; }

  .contacts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.2rem; }
  .btn { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; color: var(--fg); font-size: 0.92rem; background: var(--card); }
  .btn:hover { border-color: var(--muted); text-decoration: none; }

  .entry { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .entry:last-of-type { border-bottom: 0; }
  .row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .period { font-size: 0.88rem; white-space: nowrap; }
  .small { font-size: 0.9rem; }
  .entry p { margin: 6px 0 0; }

  .skill-group { margin-bottom: 14px; }
  .group-name { margin-bottom: 6px; }
  .skills { display: flex; flex-wrap: wrap; gap: 8px; }
  .skill { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: 5px 11px; font-size: 0.9rem; transition: transform 0.12s, border-color 0.12s; }
  .skill:hover { transform: translateY(-2px); border-color: var(--muted); }

  .langs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .lang-item { border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: 8px 12px; display: flex; flex-direction: column; }

  .more { display: flex; gap: 20px; margin-top: 1rem; }
</style>
