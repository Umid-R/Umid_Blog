---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { STACK_ICON } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base route="/projects" title={d.title} description={d.summary}>
  <article>
    <p class="muted back"><a href="/projects">← Projects</a></p>
    <h1>{d.title}</h1>
    <p class="summary">{d.summary}</p>

    <div class="links">
      {d.demo && <a href={d.demo} target="_blank" rel="noopener" class="btn primary">{d.demoLabel ?? 'Live demo'} ↗</a>}
      {d.repo && <a href={d.repo} target="_blank" rel="noopener" class="btn"><Icon name="github" mono size={16} /> View on GitHub</a>}
    </div>

    {(d.role || d.duration) && (
      <dl class="facts">
        {d.role && <><dt>Role</dt><dd>{d.role}</dd></>}
        {d.duration && <><dt>Duration</dt><dd>{d.duration}</dd></>}
        <dt>Stack</dt>
        <dd class="stack">{d.stack.map((s) => <span class="chip"><Icon name={STACK_ICON[s] ?? 'database'} size={14} />{s}</span>)}</dd>
      </dl>
    )}

    <div class="prose">
      <Content />
    </div>

    <p class="bottom">
      <a href="/projects">← All projects</a>
      {d.repo && <a href={d.repo} target="_blank" rel="noopener">Source code ↗</a>}
    </p>
  </article>
</Base>

<style>
  .back { margin-bottom: 0.4rem; font-size: 0.9rem; }
  .summary { font-size: 1.08rem; color: var(--muted); margin: 0.3rem 0 1rem; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.2rem; }
  .btn { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); border-radius: 8px; padding: 6px 13px; color: var(--fg); background: var(--card); font-size: 0.92rem; }
  .btn:hover { border-color: var(--muted); text-decoration: none; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 18px; border: 1px solid var(--line); background: var(--card); border-radius: 10px; padding: 14px 18px; margin: 0 0 2rem; font-size: 0.92rem; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 5px; font-size: 0.8rem; border: 1px solid var(--line); background: var(--bg); border-radius: 999px; padding: 2px 9px 2px 7px; }
  .bottom { display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; gap: 2px; } .facts dd { margin-bottom: 8px; } }
</style>
